# Normalize line endings. LF is canonical in the repo and on checkout for every
# platform. This prevents CRLF churn and phantom modified files on Windows.
* text=auto eol=lf

# Explicit shell and config files
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.gz binary
*.zip binary
